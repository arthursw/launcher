# Example application.yml configuration for the launcher.

name: ExampleApp
entrypoint:
  mode: script
  script: main.py
# Other entrypoint modes:
# entrypoint:
#   mode: module
#   module: example_app
#   args:
#     - --desktop
# entrypoint:
#   mode: project
#   command: example-app-gui
#   project_directory: .
# Optional. Omit for the portable default. Relative paths are resolved inside
# the launcher's per-app runtime data directory, not the process working directory.
# path: "."

# Use repository inference for GitHub/GitLab, or provide explicit endpoints.
repository: git@github.com:owner/exampleapp.git
# For self-hosted GitLab, set this if the public API cannot resolve the path.
# gitlab_project_id: "123456"
# api: https://api.github.com
# releases_endpoint: /repos/owner/exampleapp/releases/latest

auto_update: true
# version: v1.2.3

# Signed manifests are required before any downloaded archive can execute.
trust:
  mode: signed_manifest
  # Replace this with the public key printed by: launcher release keygen
  public_key: "<base64-ed25519-public-key>"
  # These default URLs match the archive, manifest, and signature produced by
  # launcher release archive, sign, and upload.
  manifest_url: "https://github.com/owner/exampleapp/releases/download/{version}/launcher-manifest.yml"
  signature_url: "https://github.com/owner/exampleapp/releases/download/{version}/launcher-manifest.yml.sig"
  archive_url: "https://github.com/owner/exampleapp/releases/download/{version}/{archive_name}"

# No release.archive config is needed when tracked files are enough.
# For generated assets, uncomment and adjust structured build/include config:
# release:
#   archive:
#     build:
#       - command: ["npm", "ci"]
#         cwd: frontend
#       - command: ["npm", "run", "build"]
#         cwd: frontend
#     include:
#       - frontend/dist
#       - source: frontend/dist
#         destination: example_app/static
# Rare full override fallback:
#     custom_script: packaging/launcher/custom_archive.py

# The dependency config must exist in the downloaded sources. Use
# configuration: null only when the app intentionally has no dependency file.
configuration: pyproject.toml
# Optional dependency groups from the dependency config, for example the group
# installed during development with: uv sync --extra desktop
# extras:
#   - desktop
# Launcher starts from the dependency config directory by default and makes that
# directory, plus its src/ folder when present, importable. Override only for
# unusual layouts:
# working_directory: backend
# pythonpath:
#   - backend/src
# install: install.py
reinstall_on_update: false

gui_timeout: 3
# Optional readiness check. If set, the app must print this text once ready.
# init_message: "Initialized"
init_timeout: 30

# Optional proxy defaults. Do not put proxy passwords here.
# Runtime proxy metadata is stored in OS app data, and remembered passwords are
# stored in the OS keychain only when the user opts in.
# proxy_servers:
#   http: http://proxy.corp.com:8080
#   https: http://proxy.corp.com:8080
#   ssl_cert_file: /path/to/corporate-ca.pem
